{
  "name": "@robinson-ai-systems/github-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted, safely guarded GitHub MCP server",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "node scripts/check-secrets.mjs && node scripts/check-docs-updated.mjs && python3 docs/pr-cards/validate-index.py && python3 scripts/count-catalog.py && npm run lint && node scripts/check-writes.mjs && node scripts/check-budgets.mjs && node scripts/check-core-imports.mjs && npm run check:developer-evidence",
    "lint": "eslint .",
    "task:brief": "node scripts/task-brief.mjs",
    "test": "vitest run --config vitest.config.js",
    "test:db": "bash scripts/local-postgres-test.sh",
    "test:shapes": "vitest run --config vitest.shapes.config.js",
    "rtc:auth-evidence": "node scripts/rtc-auth-evidence.mjs",
    "rtc:public-evidence": "node scripts/rtc-public-evidence.mjs",
    "test:rtc": "vitest run tests/unit/rtc-conformance.test.js tests/unit/rtc-http.test.js tests/unit/rtc-pass-foundation.test.js",
    "check:developer-evidence": "node scripts/check-developer-evidence.mjs && node --test scripts/check-developer-evidence.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@neondatabase/serverless": "1.2.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/webhooks": "14.2.0",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "gpt-tokenizer": "3.4.0",
    "graphql": "17.0.2",
    "pg": "8.23.1",
    "vitest": "5.0.3"
  }
}
